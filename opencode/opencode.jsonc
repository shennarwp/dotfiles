{
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "{env:NINEROUTER_URL}/v1",
        "apiKey": "{env:NINEROUTER_KEY}",
        "cacheTTL": 300000
      },
      "models": {
        "combo": {
          "name": "combo",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "ag/gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "ag/gemini-3.8-flash-low": {
          "name": "Gemini 3.8 Flash Low",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "ag/gemini-3.8-flash-medium": {
          "name": "Gemini 3.8 Flash Medium",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "ag/gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "gh/gpt-4o": {
          "name": "GPT-4o",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "gh/gpt-4.1": {
          "name": "GPT-4.1",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "gh/gpt-5.4-nano": {
          "name": "GPT-5.4 Nano",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "nvidia/nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B A55B",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "cf/@cf/qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "cf/@cf/zai-org/glm-4.7-flash": {
          "name": "GLM 4.7 Flash",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "deepseek-web/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "deepseek-web/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "oc/space-bunny-free": {
          "name": "Space Bunny Free",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "oc/big-pickle": {
          "name": "Big Pickle",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "oc/nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning Free",
          "reasoning": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "oc/muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Contributor Free",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "oc/deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash Free",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "oc/glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash Free",
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  },
  "mcp": {
    "kan": {
      "type": "local",
      "command": ["npx", "-y", "@aixlab/kanbn-mcp"],
      "environment": {
        "API_BASE_URL": "http://kan.m9.home.arpa/api/v1",
        "BEARER_TOKEN_AUTHORIZATION": "{env:KAN_TOKEN}"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
