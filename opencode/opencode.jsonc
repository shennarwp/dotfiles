{
  "plugin": [
    "@vheins/opencode-9router@latest"
  ],
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://10.147.17.5/v1",
        "apiKey": "{env:NINEROUTER_KEY}",
        "cacheTTL": 300000
      }
    },
    "oc-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Free",
      "options": {
        "baseURL": "http://10.147.17.5/v1",
        "apiKey": "{env:NINEROUTER_KEY}"
      },
      "models": {
        "oc/space-bunny-free": {
          "name": "Space Bunny Free",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "oc/big-pickle": {
          "name": "Big Pickle",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "oc/nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning Free",
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "oc/muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Contributor Free",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model": "oc-free/oc/space-bunny-free",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "oc-free/oc/space-bunny-free"
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
