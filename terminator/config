[global_config]
[keybindings]
[profiles]
  [[default]]
    background_color = "#0C0C0C"
    background_darkness = 0.0
    font = Fantasque Sans Mono 11
    foreground_color = "#D9D9D9"
    show_titlebar = False
    palette = "#1a1a1a:#f4005f:#98e024:#fd971f:#9d65ff:#f4005f:#58d1eb:#c4c5b5:#625e4c:#f4005f:#98e024:#e0d561:#9d65ff:#f4005f:#58d1eb:#f6f6ef"
    use_system_font = False
    copy_on_selection = True
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      type = Terminal
    [[[window0]]]
      parent = ""
      type = Window
[plugins]
