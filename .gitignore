# Local-only overrides. Not anchored with a leading slash, so this matches at
# any depth: the live copy in $HOME-equivalent repo root, and any hand-placed
# copy in merged/. Ignore rules only apply to untracked files, so the tracked
# ones in merged-qnap/ and merged-alpine/ are unaffected.
.bash_aliases_local

# backups produced by deploy.sh / manual copies
.dotfiles-backup-*/
*.bak
*.orig
*.rej
*~

# scratch and logs
tmp/
*.log

# generated output (shared with sibling repos)
coverage/
*.lcov
.nyc_output/
*.tsbuildinfo
build-info/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo

# JetBrains IDEs (GoLand / IntelliJ / WebStorm)
.idea/
*.iml

# gitleaks working files
.gitleaks-baseline.json
gitleaks-report.*
