# ~/.bash_aliases_local — Alpine host overrides.
# Sourced from ~/.bashrc AFTER ~/.bash_aliases (the common merged set).
# Only what the Alpine host needs to deviate from the common aliases lives here;
# it is NOT a copy of the common set.

# --- Alpine (apk) overrides: the common apt-based uu/uug are replaced ------
alias uu='sudo apk update && sudo apk upgrade'
alias uug='sudo apk update && sudo apk upgrade'
alias aai='sudo apk add'
alias aas='apk search'

# --- 9router gateway: per-host, like the API key -------------------------
# The shared merged/.bashrc no longer hardcodes the gateway name. This file
# IS deployed over ~/.bash_aliases_local, so the value has to live here to
# survive a deploy (see FIXME.md — deploy.sh overwrites the local layer on
# qnap/alpine, which is why NINEROUTER_KEY must NOT be added to this file).
export NINEROUTER_URL="http://9router.m9.home.arpa"
