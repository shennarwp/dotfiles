{
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],

    "remote.SSH.configFile": "/home/shennarwp/.ssh/config",

    "remote.SSH.remotePlatform": {
        "m9-zt": "linux",
        "m9zt": "linux"
    },

    "remote.SSH.path": "C:\\bin\\wsl-ssh.bat",

    "remote.SSH.useLocalServer": false,

    "remote.SSH.enableDynamicForwarding": false,


    "editor.fontSize": 16,

    "editor.fontFamily": "Fantasque Sans Mono",

    "editor.semanticHighlighting.enabled": false,

    "editor.minimap.enabled": false,


    "workbench.colorTheme": "Monochrome Light (fork by dkamyshov)",

    "workbench.iconTheme": "symbols",


    "workbench.colorCustomizations": {

        // Editor
        "editor.background": "#FDFDFD",
        "editor.foreground": "#1A1A1A",

        "editorCursor.foreground": "#000000",

        "editor.lineHighlightBackground": "#F7F7F7",

        "editor.selectionBackground": "#DADADA",
        "editor.inactiveSelectionBackground": "#EEEEEE",

        "editorLineNumber.foreground": "#B0B0B0",
        "editorLineNumber.activeForeground": "#555555",

        "editorIndentGuide.background": "#E8E8E8",
        "editorIndentGuide.activeBackground": "#AAAAAA",

        "editorWhitespace.foreground": "#E0E0E0",


        // Explorer / Sidebar
        "sideBar.background": "#FAFAFA",
        "sideBar.foreground": "#333333",

        "activityBar.background": "#FAFAFA",
        "activityBar.foreground": "#333333",

        "sideBarSectionHeader.background": "#F5F5F5",
        "sideBarSectionHeader.foreground": "#333333",


        // Panels
        "panel.background": "#FAFAFA",

        "panelTitle.activeForeground": "#111111",
        "panelTitle.inactiveForeground": "#888888",


        // Tabs
        "tab.activeBackground": "#FDFDFD",
        "tab.activeForeground": "#000000",

        "tab.inactiveForeground": "#888888",

        "tab.border": "#E8E8E8",


        // Status bar
        "statusBar.background": "#F2F2F2",
        "statusBar.foreground": "#444444",

        "statusBarItem.hoverBackground": "#E5E5E5",


        // Title bar
        "titleBar.activeBackground": "#FAFAFA",
        "titleBar.activeForeground": "#222222",


        // Command Palette
        "quickInput.background": "#FFFFFF",
        "quickInput.foreground": "#222222",

        "quickInputList.focusBackground": "#D2D2D2",
        "quickInputList.focusForeground": "#000000",

        "quickInputList.hoverBackground": "#EEEEEE",
        "quickInputList.hoverForeground": "#222222",

        "list.activeSelectionBackground": "#D2D2D2",
        "list.activeSelectionForeground": "#000000",

        "list.focusBackground": "#D2D2D2",
        "list.focusForeground": "#000000",

        "list.hoverBackground": "#EEEEEE",
        "list.hoverForeground": "#333333",


        // Terminal
        "terminal.background": "#FDFDFD",
        "terminal.foreground": "#1A1A1A",

        "terminalCursor.foreground": "#000000",

        "terminal.selectionBackground": "#DADADA",

        "terminal.border": "#E5E5E5",


        // Terminal monochrome ANSI
        "terminal.ansiBlack": "#1A1A1A",
        "terminal.ansiRed": "#555555",
        "terminal.ansiGreen": "#555555",
        "terminal.ansiYellow": "#666666",
        "terminal.ansiBlue": "#555555",
        "terminal.ansiMagenta": "#666666",
        "terminal.ansiCyan": "#666666",
        "terminal.ansiWhite": "#FAFAFA",

        "terminal.ansiBrightBlack": "#777777",
        "terminal.ansiBrightRed": "#444444",
        "terminal.ansiBrightGreen": "#444444",
        "terminal.ansiBrightYellow": "#555555",
        "terminal.ansiBrightBlue": "#444444",
        "terminal.ansiBrightMagenta": "#555555",
        "terminal.ansiBrightCyan": "#555555",
        "terminal.ansiBrightWhite": "#FFFFFF"
    },


    "editor.tokenColorCustomizations": {

        "textMateRules": [

            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#888888",
                    "fontStyle": "italic"
                }
            },

            {
                "scope": [
                    "keyword",
                    "storage",
                    "storage.type",
                    "entity.name.function",
                    "entity.name.type",
                    "variable",
                    "constant"
                ],
                "settings": {
                    "foreground": "#111111"
                }
            },

            {
                "scope": [
                    "string",
                    "constant.numeric",
                    "number",
                    "regexp"
                ],
                "settings": {
                    "foreground": "#555555"
                }
            },

            {
                "scope": [
                    "operator",
                    "punctuation",
                    "delimiter"
                ],
                "settings": {
                    "foreground": "#444444"
                }
            }
        ]
    },


    // Explorer refinement for Symbols
    "explorer.compactFolders": false,

    "workbench.tree.indent": 12,

    "workbench.tree.renderIndentGuides": "none",
    "redhat.telemetry.enabled": false
}
